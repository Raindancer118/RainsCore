<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>de.raindancer</groupId>
    <artifactId>RainsCore</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>

    <name>RainsCore</name>
    <description>Rain's Core — the one implementation of everything Rain's plugins do to the game</description>

    <properties>
        <!--
          Same floor as every other plugin here: Paper 26.2 ships class files at version 69, so a JDK
          below 25 cannot read paper-api at all and the build fails rather than producing a jar that
          only pretends to be portable.
        -->
        <java.version>25</java.version>
        <paper.api.version>26.2.build.68-beta</paper.api.version>
        <fastboard.version>2.2.0</fastboard.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <repositories>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>

    <dependencies>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>${paper.api.version}</version>
            <scope>provided</scope>
        </dependency>

        <!--
          FastBoard: a packet-level scoreboard, MIT, and the only library of its kind that already
          says 26.2 out loud.

          Compiled against here and fetched at runtime by Paper, through the libraries: block in
          paper-plugin.yml — not shaded. Two reasons. Paper gives each plugin's declared libraries
          their own classloader, which solves the collision that shading-with-relocation exists to
          work around, and solves it better: another plugin shipping a different FastBoard gets its
          own and neither silently wins. And maven-shade cannot read Java 25 class files at all
          ("Unsupported class file major version 69"), so the relocation route is not open to us
          until it can.

          The version is stated twice — here and in paper-plugin.yml — which is exactly the kind of
          duplication this project keeps removing, so LibraryVersionTest fails the build if the two
          ever disagree.
        -->
        <dependency>
            <groupId>fr.mrmicky</groupId>
            <artifactId>fastboard</artifactId>
            <version>${fastboard.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>5.11.4</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>3.27.3</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>${project.name}-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
                <includes>
                    <include>paper-plugin.yml</include>
                </includes>
            </resource>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>false</filtering>
                <excludes>
                    <exclude>paper-plugin.yml</exclude>
                </excludes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.13.0</version>
                <configuration>
                    <release>${java.version}</release>
                    <compilerArgs>
                        <arg>-Xlint:all,-serial,-processing</arg>
                    </compilerArgs>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.5.2</version>
            </plugin>
        </plugins>
    </build>
</project>
